# http (default): the real Kólófi API
# mock: in-memory demo data, no backend needed (login ada@example.com / Kolofi2026!, PIN 482915, email code 123456)
VITE_API_MODE=http

# Root of the API in http mode. Leave as /api/v1 in development: Vite proxies /api to KOLOFI_API_PROXY.
# In production set the full URL, e.g. https://api.kolofi.ng/api/v1 (the API must allow this origin in CORS).
VITE_API_BASE_URL=/api/v1

# Where the dev server sends /api requests (Laravel: `php artisan serve` or Herd).
KOLOFI_API_PROXY=http://kolofi-backend.test
